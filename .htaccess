Options -Indexes

RewriteEngine On
RewriteBase /cm/

# Nunca executa scripts enviados para a pasta de uploads
RewriteRule ^uploads/.*\.(php[0-9]?|phtml|phar)$ - [F,NC,L]

# Bloqueia acesso direto a código-fonte e arquivos de infraestrutura
RewriteRule ^app/ - [F,L]
RewriteRule ^database/ - [F,L]
RewriteRule ^(database\.sql|error_log|README\.md|\.cpanel\.yml)$ - [F,NC,L]

# Front controller: encaminha rotas amigáveis para index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]
